{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mochasmindlab.com"
        }
      ],
      "destination": "https://mochasmindlab.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.mochasmindlab.com"
        }
      ],
      "destination": "https://mochasmindlab.com/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mochamindlabs.com"
        }
      ],
      "destination": "https://mochasmindlab.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "mochamindlabs.com"
        }
      ],
      "destination": "https://mochasmindlab.com/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mochamindlabs.com"
        }
      ],
      "destination": "https://mochasmindlab.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.mochamindlabs.com"
        }
      ],
      "destination": "https://mochasmindlab.com/:path",
      "permanent": true
    },
    {
      "source": "/ml-fitness.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ml-fitness",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fitness",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/support.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/calorie-counter-no-subscription",
      "destination": "/calorie-counter-without-subscription.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
